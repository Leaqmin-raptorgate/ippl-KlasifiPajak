# KlasifiPajak environment skeleton — placeholders only; never commit real secrets.

APP_ENV=development

# Runtime DML user (klasifipajak_app). Prefer this for the API process.
DATABASE_URL=mysql+pymysql://klasifipajak_app:CHANGE_ME@127.0.0.1:3306/klasifipajak

# Alembic / DDL user (klasifipajak_migrate). Not for the API process.
MIGRATE_DATABASE_URL=mysql+pymysql://klasifipajak_migrate:CHANGE_ME@127.0.0.1:3306/klasifipajak

# Rejected outside APP_ENV=development|test (HB-01 / CHANGE_ME marker).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Comma-separated extra CORS origins (dev defaults already include Vite).
CORS_ORIGINS=

# Optional override for the academic ruleset JSON path.
RULESET_PATH=

# Local receipt photo root (D-01). Outside the public web root.
RECEIPT_STORAGE_ROOT=/var/lib/klasifipajak/receipts

# --- AI via 9router (OpenAI-compatible) ---
# Confirmed base. The path includes /v1. The key and each model id are
# environment values, same as each other: set them here, never in source.
# Leave a model empty until you choose it. An empty key or model fails
# closed: rules, clarification, and manual entry. No live call is made.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_CLASSIFIER=
AI_MODEL_OCR=
AI_MODEL_ASSISTANT=
AI_TIMEOUT_S=30

# Listen address for the test-support startup check (API §5.31).
# Set this to the same host the process binds. APP_ENV=test refuses any
# value other than 127.0.0.1, ::1, or localhost. Leave it empty for
# TestClient and for the development Compose API: that service is
# APP_ENV=development, publishes 127.0.0.1:8000, and does not mount
# test-support. The in-container --host 0.0.0.0 stays in Compose.
BIND_HOST=

# Optional SMTP. Empty host means password-reset mail is not delivered.
# The test-support route can still mint a token. Never log that token.
# Chosen relay: Brevo. Host smtp-relay.brevo.com, port 587 (STARTTLS).
# SMTP_USERNAME is the Login shown under Settings, SMTP & API, not the relay host.
# SMTP_PASSWORD is an SMTP key from that page, not the account password or an API key.
# SMTP_FROM must be a sender on a domain Brevo has authenticated, for example
# noreply@putrahomelab.com. Keep the real key in the local .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Midtrans (D-10) — real account later; placeholders OK for feature work ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Proxy trust (PR #3 / auth rate limits) ---
# Comma-separated peer IPs/CIDRs allowed to supply X-Forwarded-For.
# Empty = trust none (safe default). TRUSTED_PROXY_COUNT is how many
# rightmost XFF hops to peel when the peer is trusted (default 0).
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_COUNT=0
