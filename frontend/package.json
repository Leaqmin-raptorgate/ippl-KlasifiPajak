{
  "name": "klasifipajak-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "KlasifiPajak demo frontend. Vue 3 + Vite + TypeScript, no UI framework.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "3.2.7",
    "vue-tsc": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tinypool": "2.1.2"
  }
}
